# ==================================
# DEVELOPMENT MODE (Quick Start)
# ==================================
# Just set this to true and everything works!
# No other configuration needed for development.
IS_TEST=true

# ==================================
# PRODUCTION CONFIGURATION
# (Only needed when IS_TEST=false)
# ==================================

# Server Configuration
SERVER_IP=
CURTAINS_USERNAME=
CURTAINS_PASSWORD=
MD5_VALUE=

# Access control (IP whitelisting)
# Comma-separated ISP allowlist. Localhost is always allowed for development.
ALLOWED_ISP=Microsoft,Microsoft Corporation,Partner Communications,Partner Communications Ltd.

# Files
REPORTS_FILE=reports.txt
STATISTICS_FILE=statistics.txt

# Ad statistics page at /admin. Leave the password empty to disable the page.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Require a confirmation code before an uploaded ad goes live.
# Uploading is free and open by default, so this stays off.
AD_REQUIRE_CODE=false
