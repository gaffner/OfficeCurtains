# ==================================
# DEVELOPMENT MODE (Quick Start)
# ==================================
# Just set this to true and everything works!
# No other configuration needed for development.
IS_TEST=true

# ==================================
# PRODUCTION CONFIGURATION
# (Only needed when IS_TEST=false)
# ==================================

# Server Configuration
SERVER_IP=
CURTAINS_USERNAME=
CURTAINS_PASSWORD=
MD5_VALUE=

# Access control (IP whitelisting)
# Only clients whose ISP matches this value are allowed in. Localhost is always
# allowed for local development. In production this should be the office ISP.
ALLOWED_ISP=Microsoft

# Files
REPORTS_FILE=reports.txt
STATISTICS_FILE=statistics.txt
